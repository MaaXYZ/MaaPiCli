{
    "interface_version": 2,
    "controller": [
        {
            "name": "default-controller",
            "type": "Adb"
        }
    ],
    "resource": [
        {
            "name": "default-resource",
            "path": [ "resource" ],
            "hash": "Expected-Resource-Hash"
        }
    ],
    "agent": [
        {
            "child_exec": "agent-server"
        }
    ],
    "import": [ "first.json", "second.json" ],
    "task": [
        {
            "name": "main-task",
            "entry": "MainTask",
            "option": [ "shared-option", "first-import-option" ],
            "group": [ "main-group", "first-only-group" ]
        }
    ],
    "option": {
        "shared-option": {
            "type": "select",
            "cases": [ { "name": "shared-case", "label": "main-label" } ]
        },
        "password-option": {
            "type": "input",
            "inputs": [
                { "name": "api-key", "default": "default-key", "password": true },
                { "name": "note", "default": "visible" }
            ]
        },
        "checkbox-constrained": {
            "type": "checkbox",
            "cases": [ { "name": "one" }, { "name": "two" }, { "name": "three" } ],
            "default_case": [ "one", "three" ],
            "min_count": 1,
            "max_count": 2
        }
    },
    "global_option": [ "first-global", "shared-global" ],
    "group": [
        { "name": "main-group" },
        { "name": "first-group" }
    ],
    "pretask": [
        { "name": "main-first", "exec": "main-first" },
        { "name": "main-second", "exec": "main-second" }
    ],
    "preset": [
        { "name": "main-preset", "task": [] }
    ],
    "setting": [
        { "name": "main-setting", "option": [ "main-setting-option" ] }
    ]
}
